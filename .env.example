TZ=America/Chicago

# ── powerbi-vm sync scripts (po_detail_report.py / bin_inv_sync.py) ──────────
# Epicor BAQ credentials — normally set by the Run-*.ps1 runners from the
# Credential Helper; never store real values in a committed file.
EPICOR_USER=
EPICOR_PASS=

# Neon Postgres writer. When set, the sync scripts write to Postgres instead
# of local SQLite. Use the *direct* (non-pooled) writer connection string.
# The Run-*.ps1 runners load this from the DPAPI-encrypted file created by
# Set-NeonDatabaseUrl.ps1 if the variable is not already set.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Set to 1 to write to BOTH Postgres and local SQLite during validation
# (see handoff-powerbi.md "dual-write").
DUAL_WRITE=

# Set to 1 to force Neon's SQL-over-HTTP endpoint (POST https://<host>/sql on
# port 443). When unset, the scripts probe TCP 5432 and fall back to HTTP
# automatically if the port is firewalled (as it is on powerbi-vm).
NEON_HTTP=

# Optional overrides of the Epicor BAQ endpoints (used for testing).
EPICOR_PO_BAQ_URL=
EPICOR_BININV_BAQ_URL=
