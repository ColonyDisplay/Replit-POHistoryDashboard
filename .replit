modules = ["python-3.12", "nodejs-20", "web"]

[nix]
channel = "stable-25_05"
packages = ["postgresql"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "([ -d next-ui/out ] || (npm ci --prefix next-ui --no-audit --no-fund && npm run build --prefix next-ui)) && uvicorn po_api:app --host 0.0.0.0 --port 5000 --reload"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[userenv]

[userenv.shared]
ENABLE_SCRIPT_RUNNER = "0"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 240000

[deployment]
deploymentTarget = "gce"
run = ["python", "-m", "uvicorn", "po_api:app", "--host", "0.0.0.0", "--port", "5000"]
build = ["bash", "-c", "npm ci --prefix next-ui --no-audit --no-fund && npm run build --prefix next-ui"]

[[ports]]
localPort = 5000
externalPort = 80
