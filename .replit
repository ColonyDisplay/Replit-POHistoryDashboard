modules = ["python-3.12", "nodejs-20", "web"]

[nix]
channel = "stable-25_05"
packages = ["gitFull", "libxcrypt", "playwright-driver", "postgresql"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "visual-regression"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "neon-schema"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PREVIEW_ADMIN_MODE=1 PREVIEW_LIVE_DATA=1; export PREVIEW_ADMIN_MODE PREVIEW_LIVE_DATA; ([ -d next-ui/node_modules ] || npm ci --prefix next-ui --no-audit --no-fund) && npm run build --prefix next-ui && uvicorn po_api:app --host 0.0.0.0 --port 5000 --reload"
waitForPort = 5000

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m pytest -q"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "visual-regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run test:visual --prefix next-ui"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "neon-schema"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python scripts/validate_neon_schema.py"

[workflows.workflow.metadata]
isValidation = true

[userenv]

[userenv.shared]
ENABLE_SCRIPT_RUNNER = "0"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 240000

[deployment]
deploymentTarget = "gce"
run = ["python", "-m", "uvicorn", "po_api:app", "--host", "0.0.0.0", "--port", "5000"]
build = ["bash", "-c", "printf 'Running Neon release validation\n' && python scripts/validate_neon_schema.py && printf 'Running release validation: python -m pytest -q\n' && if ! python -m pytest -q; then printf 'Release validation failed: python -m pytest -q\n' >&2; exit 1; fi && npm ci --prefix next-ui --no-audit --no-fund && npm run build --prefix next-ui"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5099
externalPort = 3000
